# Copy to deploy/.env and edit. Never commit .env.

# Host ports (change if something else already uses them)
POSTGRES_HOST_PORT=55432
NATS_HOST_PORT=4222
API_HOST_PORT=8080

# Worker counts
FETCHER_REPLICAS=3
EXTRACTOR_REPLICAS=2
SCHEDULER_REPLICAS=2
# Parallel tasks inside each fetcher / extractor container
FETCH_CONCURRENCY=4
EXTRACT_CONCURRENCY=2
SCORE_CONCURRENCY=4

# Politeness: minimum gap between two requests to the same domain, across all fetchers
DOMAIN_INTERVAL_MS=1000
# Contact address shown to sites in the User-Agent (an email or URL of yours)
CRAWLER_CONTACT=

# Currency conversion for salaries stated in foreign currency
USD_TO_INR=88
EUR_TO_INR=96
GBP_TO_INR=112

# Optional LLM (OpenAI-compatible: Groq, Ollama). Leave empty to keep it off.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Optional Telegram alert for jobs with fit score above 80
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Optional self-hosted search for discovery (docker compose --profile search up)
SEARXNG_URL=
